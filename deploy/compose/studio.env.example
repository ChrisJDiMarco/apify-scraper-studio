# Copy to studio.env. Settings for the studio container that aren't secret (docs/web-deploy.md has the full table).
# The secret key goes in secrets.env, never here: anything the server starts could read it from the environment.

# Company sign-in. Only these domains get in; these people are always admins (also the way back in).
STUDIO_ALLOWED_EMAIL_DOMAINS=semrush.com
STUDIO_ADMIN_EMAILS=lead@semrush.com,ops@semrush.com

# The page's public address: requests must come from it, and https makes the session cookie Secure.
STUDIO_PUBLIC_ORIGIN=https://studio.example.com
STUDIO_SECURE_COOKIES=1

# Logs are JSON lines on stdout (docker compose logs studio): error, warn, info or debug.
STUDIO_LOG_LEVEL=info
