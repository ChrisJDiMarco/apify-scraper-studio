# /etc/scraper-studio/studio.env: settings that aren't secret (docs/web-deploy.md has the full table). The secret key
# and admin password go in /etc/scraper-studio/secrets (root-owned, 0600), never here.

# Bound to localhost: the reverse proxy on this machine (Caddy or nginx, with your SSO in front) reaches it there.
STUDIO_HOST=127.0.0.1
PORT=4174

# Company sign-in through the proxy (or leave these out and put STUDIO_PASSWORD in the secrets file).
STUDIO_TRUSTED_EMAIL_HEADER=x-forwarded-email
STUDIO_ALLOWED_EMAIL_DOMAINS=semrush.com
STUDIO_ADMIN_EMAILS=lead@semrush.com,ops@semrush.com
# The proxy runs on this machine, so it connects from loopback.
STUDIO_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

STUDIO_PUBLIC_ORIGIN=https://studio.example.com
STUDIO_SECURE_COOKIES=1
STUDIO_TRUST_PROXY=1
STUDIO_LOG_LEVEL=info
