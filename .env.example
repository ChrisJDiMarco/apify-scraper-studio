# Scraper Studio environment variables: every variable the code reads, with defaults.
#
# Nothing loads this file automatically. Copy it to .env (git-ignored) and feed it to the process yourself:
#   docker run --env-file .env …   |   systemd EnvironmentFile=/srv/studio/.env   |   set -a; . ./.env; set +a
# Everything is commented out: uncomment only what you change (the Docker image sets its own STUDIO_HOST and STUDIO_DATA_DIR).
# Use absolute paths: docker and systemd don't expand ~. Full reference: docs/web-deploy.md (Configuration and Secrets).
#
# NEVER put STUDIO_SECRET_KEY or STUDIO_PASSWORD here. They go in a separate secrets file read through
# STUDIO_SECRETS_FD (below), so the AI command-line tools, which run shell commands as the server's user, can't read them.

# ---------------------------------------------------------------------------------------------------------------
# Browser studio server (npm run start:web → scripts/studio-web.cjs)
# ---------------------------------------------------------------------------------------------------------------

# Studio data: runs, collected posts, reports, people, encrypted keys. Back this folder up; one server process per folder.
# Default ~/.scraper-studio-web; the container uses /data.
# STUDIO_DATA_DIR=/srv/studio

# Bind address and port. Default 127.0.0.1:4174; the container binds 0.0.0.0.
# STUDIO_HOST=127.0.0.1
# PORT=4174

# The public address, when a proxy rewrites Host. Requests must come from this origin; https also marks the cookie Secure.
# STUDIO_PUBLIC_ORIGIN=https://studio.example.com

# 1 = mark the session cookie Secure and send HSTS. Set it behind HTTPS.
# STUDIO_SECURE_COOKIES=1

# 1 = count admin-password tries per client using X-Forwarded-For. Only when nothing but the proxy can reach the studio.
# STUDIO_TRUST_PROXY=1

# Where browser uploads and downloads are staged. Default: STUDIO_DATA_DIR/web-transfers.
# STUDIO_TRANSFER_DIR=/srv/studio-transfers

# How many days a new personal sign-in link works (password mode). Default 30; 0 = until replaced or turned off.
# STUDIO_LINK_DAYS=30

# Lowest server log level written to stdout as JSON lines: error, warn, info (default) or debug.
# STUDIO_LOG_LEVEL=info

# On SIGTERM/SIGINT, how many seconds running work may finish. Default 25; keep the platform's stop grace period longer.
# STUDIO_DRAIN_SECONDS=25

# Idle keep-alive for proxy connections, in seconds. Default 75; keep it above the proxy's idle timeout.
# STUDIO_KEEPALIVE_SECONDS=75

# Live-update streams for the whole server (default 200) and per person, their newest tabs (default 5).
# STUDIO_MAX_EVENT_STREAMS=200
# STUDIO_MAX_STREAMS_PER_PERSON=5

# /readyz fails below this much free disk in the data folder, in MB. Default 256.
# STUDIO_MIN_FREE_MB=256

# Leftover export copies older than this many days are removed at start. Default 7.
# STUDIO_EXPORT_DAYS=7

# ---------------------------------------------------------------------------------------------------------------
# Company sign-in (SSO through a proxy such as oauth2-proxy or Cloudflare Access). Leave unset for password mode.
# ---------------------------------------------------------------------------------------------------------------

# Header the proxy sets with the signed-in email, e.g. x-forwarded-email or x-auth-request-email.
# STUDIO_TRUSTED_EMAIL_HEADER=x-forwarded-email

# Required with the header: comma-separated email domains allowed in. Other emails are refused.
# STUDIO_ALLOWED_EMAIL_DOMAINS=example.com

# Required with the header unless STUDIO_PROXY_SECRET is in the secrets file: the proxy's IPs or CIDR ranges. The header
# is ignored from any other address, and the server won't start with neither.
# STUDIO_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Comma-separated emails that are always admins (and the way back in if nobody else is).
# STUDIO_ADMIN_EMAILS=alex@example.com,sam@example.com

# ---------------------------------------------------------------------------------------------------------------
# Secrets (browser studio)
# ---------------------------------------------------------------------------------------------------------------

# The secrets come as NAME=value lines from ONE of these (setting both is an error):
#   STUDIO_SECRETS_FD    an open file descriptor, usually 0 (standard input):
#                        STUDIO_SECRETS_FD=0 npm run start:web < ~/.scraper-studio-secrets
#   STUDIO_SECRETS_FILE  a file path read once at start: Docker/compose secrets, a Kubernetes Secret volume
# The secrets file (chmod 600, never committed) holds:
#   STUDIO_SECRET_KEY=<openssl rand -hex 32>   required; encrypts keys saved in Settings. Keep it: losing it means re-entering them.
#   STUDIO_PASSWORD=<16+ characters>           the break-glass admin password; not needed when sign-in comes from a proxy
#   STUDIO_PROXY_SECRET=<random string>        what the sign-in proxy sends to prove a request came through it
# Setting any of them directly in the environment still works, with a startup warning.
# STUDIO_SECRETS_FD=0
# STUDIO_SECRETS_FILE=/run/secrets/scraper-studio

# When started as root: the user[:group] to switch to after reading the secrets. Without it the server refuses to run
# as root. The Docker image sets node.
# STUDIO_RUN_AS=studio:studio

# ---------------------------------------------------------------------------------------------------------------
# AI limits (both off unless set)
# ---------------------------------------------------------------------------------------------------------------

# At most this many AI calls (text and pictures) at once across the studio; the rest queue.
# STUDIO_AI_CONCURRENCY=4

# Refuse new AI work once the day's recorded spend (UTC, in <data>/ai-spend.json) reaches this. Codex isn't counted.
# STUDIO_DAILY_AI_BUDGET_USD=50

# 1 = let Codex load the operator's ~/.codex/config.toml; 0 = skip it. Default: skipped on the web, loaded on the Mac.
# STUDIO_CODEX_USER_CONFIG=0

# ---------------------------------------------------------------------------------------------------------------
# Service keys: a fallback only. Prefer Settings → Keys, which encrypts them (keychain on the Mac, STUDIO_SECRET_KEY on
# the server). A key saved in Settings wins over the environment. The studio removes these from the AI tools' environment.
# ---------------------------------------------------------------------------------------------------------------

# APIFY_API_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_SHEETS_WEBHOOK_URL=
# GOOGLE_DOCS_ACCESS_TOKEN=
# MONDAY_API_TOKEN=

# ---------------------------------------------------------------------------------------------------------------
# Backups (npm run backup → scripts/studio-backup.cjs)
# ---------------------------------------------------------------------------------------------------------------

# Where backups go. Default ./studio-backups (git-ignored). A backup holds people's data: keep it out of the repo.
# STUDIO_BACKUP_DIR=/srv/studio-backups

# Keep only the newest N backups. Unset keeps all.
# STUDIO_BACKUP_KEEP=14

# ---------------------------------------------------------------------------------------------------------------
# Desktop app development
# ---------------------------------------------------------------------------------------------------------------

# 1 = in dev runs (npm run dev / preview), don't read OPENAI_API_KEY from <app folder>/.env.local. Packaged builds never read it.
# STUDIO_DISABLE_LOCAL_ENV=1

# Generic update feed URL. Auto-update is switched off in code today; only Release diagnostics read this.
# APIFY_STUDIO_AUTO_UPDATE_URL=https://updates.example.com/scraper-studio

# Claude model for scripts that create a studio host directly. The app itself uses the model chosen in Settings.
# CLAUDE_MODEL=

# Where scripts/service-smoke.cjs writes its receipts. Default: a fresh temp folder.
# STUDIO_VERIFICATION_DIR=/tmp/studio-verification

# ---------------------------------------------------------------------------------------------------------------
# macOS release (npm run dist:mac). Notarization runs only when all three Apple values are set.
# ---------------------------------------------------------------------------------------------------------------

# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
# Read by electron-builder itself (not the app): the signing identity, e.g. "Developer ID Application: <Company> (<TEAMID>)".
# CSC_NAME=

# ---------------------------------------------------------------------------------------------------------------
# Set by the tooling. Don't set these by hand.
# ---------------------------------------------------------------------------------------------------------------
# STUDIO_RUNTIME=web        set by scripts/studio-web.cjs; switches the shared main-process code to the browser studio
# ELECTRON_RENDERER_URL     set by electron-vite dev; the dev server the desktop window loads
# SHELL, PATH, APPDATA      read from the OS to find the claude and codex command-line tools
