{
  "name": "apify-scraper-studio",
  "version": "0.3.0",
  "private": true,
  "description": "Desktop (macOS and Windows) and browser workspace for Apify research, source-linked findings, and Claude Opus 5.5 analysis.",
  "main": "./out/main/index.js",
  "author": "Chris DiMarco",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisJDiMarco/apify-scraper-studio.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "studioDefaultWorkspace": "semrush",
  "studioWorkspace": {
    "mode": "single",
    "id": "semrush",
    "editionId": "semrush",
    "name": "Main"
  },
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-main-modules.mjs",
    "preview": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "release:diagnostics": "node scripts/release-diagnostics.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:desktop": "electron scripts/desktop-smoke.cjs",
    "build:web": "vite build --config vite.web.config.mjs",
    "start:web": "node scripts/studio-web.cjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "start:semrush": "npm run build && electron . --studio-workspace=semrush",
    "icons:mac": "node scripts/build-mac-icon.mjs",
    "dist:mac": "npm run icons:mac && npm run build && electron-builder --mac --universal",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build:web",
    "backup": "node scripts/studio-backup.cjs",
    "restore": "node scripts/studio-restore.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "apify-client": "^2.23.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.22.0",
    "papaparse": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "saxes": "^6.0.0",
    "unzipper": "^0.12.5",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-bubble-menu": "3.31.4",
    "@tiptap/extension-collaboration": "3.31.4",
    "@tiptap/extension-collaboration-caret": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/y-tiptap": "3.0.9",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "basic-ftp": "^6.2.3"
  },
  "build": {
    "appId": "com.chrisdimarco.apifyscraperstudio",
    "productName": "Scraper Studio",
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json",
      "README.md",
      "scripts/google-sheets-webhook.gs",
      "!**/.env",
      "!**/.env.*",
      "!**/*.pem",
      "!**/*.key"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist"
    },
    "afterSign": "scripts/notarize-if-configured.cjs",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Scraper-Studio-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
