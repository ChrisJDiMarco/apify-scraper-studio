{
  "name": "apify-scraper-studio",
  "version": "0.1.0",
  "description": "Local macOS workspace for Apify research, source-linked findings, and Claude Opus 5.5 analysis.",
  "main": "./out/main/index.js",
  "author": "Chris DiMarco",
  "license": "UNLICENSED",
  "studioDefaultWorkspace": "semrush",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-main-modules.mjs",
    "preview": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "release:diagnostics": "node scripts/release-diagnostics.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:desktop": "electron scripts/desktop-smoke.cjs",
    "build:web": "vite build --config vite.web.config.mjs",
    "start:web": "node scripts/studio-web.cjs",
    "dist:win": "npm run build && electron-builder --win nsis",
    "start:semrush": "npm run build && electron . --studio-workspace=semrush",
    "icons:mac": "node scripts/build-mac-icon.mjs",
    "dist:mac": "npm run icons:mac && npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "apify-client": "^2.23.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.22.0",
    "papaparse": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unzipper": "^0.12.5",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.chrisdimarco.apifyscraperstudio",
    "productName": "Scraper Studio",
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json",
      "README.md",
      "scripts/google-sheets-webhook.gs",
      "!**/.env",
      "!**/.env.*",
      "!**/*.pem",
      "!**/*.key"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist"
    },
    "afterSign": "scripts/notarize-if-configured.cjs",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
