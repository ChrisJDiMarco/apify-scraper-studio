    { "id": "create", "label": "Create content" },
    { "id": "pictures", "label": "Pictures" },
    { "id": "video", "label": "Video" },
    { "id": "assistant", "label": "Ask AI" },
    { "id": "data", "label": "Data tools" }
  ],
  "tasks": [
    { "id": "research.discovery", "label": "Find candidate trends", "group": "research", "kind": "text", "powers": ["Reads each 200-post batch in a research run and lists candidate trends"], "promptIds": ["research.discovery"], "programStage": "discovery", "default": { "route": "@text", "model": "claude-opus-5-5", "effort": "medium" }, "needs": { "strongReader": true, "minContextTokens": 200000 }, "calledBy": "content-workspace.js performDiscovery" },
