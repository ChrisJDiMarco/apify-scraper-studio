    { "id": "research.tagging", "label": "Tag every post", "group": "research", "kind": "text", "powers": ["Tags each collected post with the trends it supports"], "promptIds": ["research.tagging"], "programStage": "tagging", "default": { "route": "@text", "model": "claude-fable-5-1", "effort": "low" }, "calledBy": "content-workspace.js classifyBatch" },
    { "id": "quickScans.discovery", "label": "Quick scan: find trends", "group": "quickScans", "kind": "text", "powers": ["Reads the posts a quick scan collects"], "promptIds": ["research.discovery"], "programStage": "discovery", "inherit": "research.discovery", "default": { "route": "@inherit", "model": "@inherit", "effort": "@inherit" }, "lite": { "effort": "low", "model": "@cheapestStrongReader" }, "calledBy": "content-workspace.js performDiscovery (quick scans)" },
