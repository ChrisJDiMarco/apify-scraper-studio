    { "id": "quickScans.report", "label": "Quick scan trends report", "group": "quickScans", "kind": "text", "powers": ["The short trends report a quick scan from Ask AI writes"], "promptIds": ["reports.scan-report"], "programStage": "reports", "inherit": "quickScans.synthesis", "default": { "route": "@inherit", "model": "@inherit", "effort": "@inherit" }, "lite": { "effort": "low", "model": "@cheapestStrongReader" }, "calledBy": "content-workspace.js quick scan report" },
