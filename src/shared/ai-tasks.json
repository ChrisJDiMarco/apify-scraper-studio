{
  "//": "Every kind of AI work the studio does (a task), with its default route, model and effort. src/main/ai-routing.js resolves a task: a run's snapshot, then a research program's own choice for its stage, then the studio's Model routing choice, then the inherit chain, then the defaults for its kind. '@text' / '@textModel' are the studio's text default (Settings → Model routing), '@inherit' takes the field from the inherited task. Read by main and the renderer.",
  "version": 1,
  "groups": [
    { "id": "research", "label": "Research" },
    { "id": "quickScans", "label": "Quick scans" },
    { "id": "reports", "label": "Reports" },
